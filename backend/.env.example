# V6 起大模型配置默认保存在数据库，不再要求在代码里写死。
# 可选：首次启动时自动创建一个演示配置。
INIT_DEMO_MODEL_CONFIG=true

# 前端地址，用于 CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173

# ---------------- 设备接入（MQTT） ----------------
# 未安装 paho-mqtt 或 MQTT_ENABLED=false 时后端不订阅，不影响其他功能
MQTT_ENABLED=false
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=fire
MQTT_CLIENT_ID=fire-ai-agent-backend

# ---------------- 设备签名校验 ----------------
# 允许的客户端与服务端时间偏移（秒）
DEVICE_SIGN_MAX_SKEW_SECONDS=300
# nonce 记录保留时长（分钟），保留期内重复即判定为重放
DEVICE_NONCE_RETENTION_MINUTES=15

# ---------------- 备份与报表 ----------------
# 备份目录与保留天数（python db_backup.py backup）
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
# 报表产物存储目录（默认 backend/data/reports）
REPORT_STORAGE_DIR=

# ---------------- 运行时库 ----------------
# 运行时 SQLite 库（巡检档案、整改工单、学习答题、RAG 条目等）的落盘路径。
# 留空时回落到 backend/data/fire_agent_runtime.db。
# 容器部署必须指向可写数据卷：镜像根文件系统是只读的，默认路径写不进去。
RUNTIME_DB_PATH=

# ---------------- 数据库结构迁移 ----------------
# 表结构由 Alembic 版本化，启动时自动推到最新版本。
# 设为 false 则应用完全不动结构，改由发布流程执行 `alembic upgrade head`。
DB_AUTO_MIGRATE=true

# ---------------- 视频平台接入 ----------------
# 摄像头/NVR 登录密码的加密密钥（生产必须配置）。
# 留空时先回退 JWT_SECRET_KEY；开发环境都没有则自动生成 backend/.video_credential_key。
VIDEO_CREDENTIAL_KEY=
# 设备探测/抓拍超时、抓拍缓存与抓拍令牌有效期
VIDEO_PROBE_TIMEOUT_SECONDS=10
VIDEO_SNAPSHOT_TIMEOUT_SECONDS=10
VIDEO_SNAPSHOT_CACHE_SECONDS=3
VIDEO_SNAPSHOT_TOKEN_SECONDS=3600

# 共享订阅组：多实例同时订阅时，broker 只把每条消息投给组内一个实例。
# 留空表示普通订阅，此时靠 device_messages 的幂等约束兜底重复投递。
MQTT_SHARED_GROUP=
# 设备消息处理失败的最大尝试次数，超过后进入死信（可人工重放）
DEVICE_MESSAGE_MAX_ATTEMPTS=3

# ---------------- 对象存储（可选） ----------------
# local = 仅本地磁盘（默认）；s3 = 本地照写并镜像到 S3 兼容对象存储
# 多实例部署且各实例卷不共享时必须启用，否则 A 实例上传的文件 B 实例读不到
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=fire-ai
S3_PATH_STYLE=true
S3_VERIFY_TLS=true
S3_TIMEOUT_SECONDS=20

# ---------------- 后台任务队列 ----------------
# 进程内 worker：随应用启动，消费 background_tasks 表里的任务
TASK_WORKER_ENABLED=true
# 队列空闲时的轮询间隔（秒）
TASK_WORKER_POLL_SECONDS=2
# 运行中任务的续租间隔（秒），需小于任务租约时长（默认 900 秒）
TASK_WORKER_HEARTBEAT_SECONDS=60
# 回收租约过期任务的检查间隔（秒）
TASK_WORKER_RECOVER_SECONDS=60

# ---------------- 生产环境初始管理员 ----------------
# 全新库且没有任何用户时，用这两个变量创建首个管理员（口令需 >=8 位且含字母与数字）；
# 留空则打印提示，改由 `python create_admin.py --username ... --password ...` 创建。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ---------------- GB/T 26875 消防主机（用户信息传输装置）接入 ----------------
# 默认关闭；接真实消防主机时置 true，并保证 5016 端口对消防主机可达
GB26875_ENABLED=false
GB26875_LISTEN_HOST=0.0.0.0
GB26875_LISTEN_PORT=5016
# 监控中心自身的 12 位国标地址，需与消防主机侧登记一致
GB26875_CENTER_ADDRESS=000000000000

# ---------------- GB28181 视频接入 ----------------
# 默认关闭；接真实 IPC/NVR 时置 true，并部署 ZLMediaKit 后填写下面的媒体服务器配置
GB28181_ENABLED=false
GB28181_SIP_LISTEN_HOST=0.0.0.0
GB28181_SIP_LISTEN_PORT=5060
GB28181_SIP_SERVER_ID=34020000002000000001
GB28181_SIP_DOMAIN=3402000000
GB28181_SIP_PASSWORD=
GB28181_SIP_ADVERTISE_HOST=
GB28181_REGISTER_EXPIRES=3600
GB28181_MEDIA_API_BASE=
GB28181_MEDIA_SECRET=
GB28181_MEDIA_HTTP_HOST=
GB28181_MEDIA_HTTP_PORT=8081
GB28181_MEDIA_RTP_HOST=
GB28181_MEDIA_SERVER_HOST=
GB28181_RTP_PORT_RANGE=10000,10500

# ---------------- 告警外部通知通道 ----------------
# 通道（通用 Webhook / 企业微信 / 钉钉 / 邮件）在「消息中心 → 通知设置」里配置并加密落库，
# 这里只放总开关与发送参数；未配置任何通道时不会发送
ALERT_NOTIFY_ENABLED=true
# 单次发送超时（秒）
ALERT_NOTIFY_TIMEOUT_SECONDS=10
# 发送失败的重试次数（由后台任务队列执行，超过后记录为最终失败）
ALERT_NOTIFY_MAX_ATTEMPTS=3
