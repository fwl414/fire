# staging 环境变量模板：cp .env.staging.example .env.staging
# staging 与生产使用同一镜像，但独立端口、独立数据库，用于上线前验收

# ---------------- 必填 ----------------
# 驱动须为 postgresql+psycopg（项目依赖 psycopg 3）
DATABASE_URL=postgresql+psycopg://fire:CHANGE_ME@postgres:5432/fire_ai_agent_staging
POSTGRES_DB=fire_ai_agent_staging
POSTGRES_USER=fire
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# ---------------- 部署参数 ----------------
HTTP_PORT=8080
IMAGE_TAG=staging
CORS_ORIGINS=http://127.0.0.1:8080
# 容器名前缀：与生产（fire_ai）区分，便于同机并存
CONTAINER_PREFIX=fire_ai_staging

# ---------------- 监控（启用 deploy/docker-compose.monitoring.yml 时必填） ----------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
ALERT_WEBHOOK_URL=http://127.0.0.1:9095/webhook
MONITORING_BIND=127.0.0.1

# ---------------- 设备接入（staging 建议关闭或指向测试 broker） ----------------
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=fire

# ---------------- 视频平台接入 ----------------
# 摄像头凭证的加密密钥，staging 请使用与生产不同的一份
VIDEO_CREDENTIAL_KEY=
VIDEO_SNAPSHOT_CACHE_SECONDS=3
VIDEO_SNAPSHOT_TOKEN_SECONDS=3600
