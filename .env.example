# 生产环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# 注意：生产模式下后端会拒绝 SQLite，必须使用 PostgreSQL，且 JWT_SECRET_KEY 长度需 >= 32

# ---------------- 必填 ----------------
# PostgreSQL 连接串（服务名 postgres 由 docker compose 内部解析）
# 注意：本项目依赖 psycopg 3，驱动须为 postgresql+psycopg（不是 psycopg2）
DATABASE_URL=postgresql+psycopg://fire:CHANGE_ME_STRONG_PASSWORD@postgres:5432/fire_ai_agent
POSTGRES_DB=fire_ai_agent
POSTGRES_USER=fire
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT 签名密钥（>=32 位随机串）：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING

# Prometheus 抓取 /metrics 所需的令牌（>=32 位随机串）
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# ---------------- 部署参数 ----------------
# 对外 HTTP 端口（仅用于 ACME 校验与 301 跳转 HTTPS）
HTTP_PORT=80
# 对外 HTTPS 端口（唯一业务入口）；证书放置见 deploy/certbot/README.md
HTTPS_PORT=443
# 镜像版本号，由 scripts/release.sh 自动传入，用于版本化与回滚
IMAGE_TAG=latest
# 前端跨域来源（同域部署可留空）
CORS_ORIGINS=

# ---------------- 数据保留 ----------------
# 备份保留天数（python db_backup.py prune 使用）
BACKUP_RETENTION_DAYS=14

# ---------------- 数据库结构迁移 ----------------
# 表结构由 Alembic 版本化（backend/alembic），不再依赖启动时 create_all：
#   全新库 -> 建出全部表；存量库 -> 先打基线标记，之后按迁移升级。
# 留 true：应用启动时自动迁移（多实例由 runtime_locks 互斥，其余实例等它完成）。
# 设 false：应用完全不动结构，改由发布流程执行 `alembic upgrade head`
#          （scripts/release.sh 已包含这一步）。
DB_AUTO_MIGRATE=true

# ---------------- 设备 MQTT 接入（按需） ----------------
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=fire

# ---------------- GB/T 26875 消防主机接入（按需） ----------------
# 开启后 backend 容器监听 5016，消防主机（用户信息传输装置）按国标协议直连上报
GB26875_ENABLED=false
GB26875_LISTEN_HOST=0.0.0.0
GB26875_LISTEN_PORT=5016
# 监控中心自身的 12 位国标地址，需与消防主机侧登记的中心地址一致
GB26875_CENTER_ADDRESS=000000000000

# ---------------- GB28181 视频接入（按需） ----------------
# 开启后 backend 容器监听 5060（UDP+TCP）处理 SIP 信令，媒体流走 zlmediakit 容器
GB28181_ENABLED=false
GB28181_SIP_LISTEN_HOST=0.0.0.0
GB28181_SIP_LISTEN_PORT=5060
# 平台（监控中心）国标编码与域，需与设备侧登记一致
GB28181_SIP_SERVER_ID=34020000002000000001
GB28181_SIP_DOMAIN=3402000000
# 设备侧登记的平台接入口令；留空表示不做 Digest 认证（不建议在生产留空）
GB28181_SIP_PASSWORD=
# 平台在 Via/Contact 中声明的地址，填宿主机对外可达的 IP（留空则用监听地址）
GB28181_SIP_ADVERTISE_HOST=
# 媒体服务器（ZLMediaKit）：API 地址、鉴权 secret、前端可访问的播放地址、设备可推流的 RTP 地址
GB28181_MEDIA_API_BASE=http://zlmediakit:80/index/api
GB28181_MEDIA_SECRET=
GB28181_MEDIA_HTTP_HOST=
GB28181_MEDIA_HTTP_PORT=8081
GB28181_MEDIA_RTP_HOST=
GB28181_RTP_PORT_RANGE=10000-10500
# ZLMediaKit 镜像（默认官方 master；拉取失败时可换私有仓库地址）
ZLMEDIAKIT_IMAGE=zlmediakit/zlmediakit:master

# ---------------- 告警外部通知通道 ----------------
# 通道（通用 Webhook / 企业微信 / 钉钉 / 邮件）在「消息中心 → 通知设置」里配置，密钥加密落库；
# 这里只放总开关与发送参数，未配置任何通道时不会发送
ALERT_NOTIFY_ENABLED=true
ALERT_NOTIFY_TIMEOUT_SECONDS=10
ALERT_NOTIFY_MAX_ATTEMPTS=3

# ---------------- 首次部署初始管理员 ----------------
# 全新库且没有任何用户时，用这两个变量创建首个管理员；留空则改用
# docker compose exec backend python create_admin.py --username ... --password ...
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ---------------- 设备签名与告警策略（可选，留空用默认值） ----------------
DEVICE_SIGN_MAX_SKEW_SECONDS=300
DEVICE_NONCE_RETENTION_MINUTES=15
ALERT_DEDUP_WINDOW_MINUTES=30
ALERT_ESCALATE_REPEAT_THRESHOLD=3
ALERT_ESCALATE_SLA_MINUTES=120

# ---------------- 视频平台接入 ----------------
# 摄像头/NVR 的登录密码需要原样取回用于对接设备，因此加密落库。
# 生产环境必须显式配置；留空时会回退 JWT_SECRET_KEY，两者都没有则拒绝保存凭证。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
VIDEO_CREDENTIAL_KEY=
# 设备探测/抓拍超时与抓拍缓存（同一通道在缓存期内共享一张图，避免多路轮询打满设备）
VIDEO_PROBE_TIMEOUT_SECONDS=10
VIDEO_SNAPSHOT_TIMEOUT_SECONDS=10
VIDEO_SNAPSHOT_CACHE_SECONDS=3
# 抓拍令牌有效期（秒），浏览器 <img> 无法带请求头，改用短时令牌
VIDEO_SNAPSHOT_TOKEN_SECONDS=3600

# ---------------- 后台任务队列 ----------------
# 进程内 worker 随应用启动消费 background_tasks 表；多实例部署时各实例共享同一队列
# （领取用「UPDATE ... WHERE status='pending'」原子判定，不会重复执行）
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_SECONDS=2
TASK_WORKER_HEARTBEAT_SECONDS=60
TASK_WORKER_RECOVER_SECONDS=60

# ---------------- 设备消息收件箱 ----------------
# 多实例订阅同一批主题时，配置共享订阅组让 broker 在组内只投给一个实例
MQTT_SHARED_GROUP=
DEVICE_MESSAGE_MAX_ATTEMPTS=3

# ---------------- 对象存储（多实例必须启用） ----------------
# 多副本各自挂卷时，A 副本上传的文件 B 副本读不到；启用对象存储后写入会镜像、
# 读取时本地缺失自动回源
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=fire-ai
S3_PATH_STYLE=true
S3_VERIFY_TLS=true

# ---------------- 水平扩展（仅 deploy/docker-compose.scale.yml 使用） ----------------
# 单容器内 uvicorn 进程数；多副本时保持 1 由副本数扩展
UVICORN_WORKERS=1
BACKEND_REPLICAS=2
